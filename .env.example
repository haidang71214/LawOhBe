# ===================================================
# APP CONFIGURATION
# ===================================================
PORT=3300
NODE_ENV=development
GLOBAL_PREFIX=api/v1
CLIENT_URL=https://lawoh.click

# ===================================================
# MONGODB CONFIGURATION (Container: law_mongodb)
# ===================================================
MONGO_URL=mongodb://root:password@localhost:27017?authSource=admin
MONGO_DB_NAME=law_ohbe
MONGO_POOL_SIZE=10
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=10000

# ===================================================
# REDIS CONFIGURATION (Container: law_redis_server)
# ===================================================
REDIS_HOST=localhost
REDIS_PORT=6379
TIME_TO_LIVE=3600

# ===================================================
# KAFKA CONFIGURATION (Container: law_kafka_server)
# ===================================================
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_URL=localhost:9092

# ===================================================
# LOKI & OPENTELEMETRY (Container: law_loki)
# ===================================================
LOKI_HOST=http://localhost:3100
ENABLE_LOKI_PUSH=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ===================================================
# CLOUDINARY CONFIGURATION
# ===================================================
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ===================================================
# EMAIL CONFIGURATION (SMTP)
# ===================================================
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# ===================================================
# VNPAY CONFIGURATION
# ===================================================
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# ===================================================
# GEMINI AI CONFIGURATION
# ===================================================
GEMINI_API_1=your_gemini_api_key

